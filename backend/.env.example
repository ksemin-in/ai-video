# ════════════════════════════════════════════════════════════════
#   AI Traffic Surveillance System — Environment Configuration
#   Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────
APP_NAME="AI Traffic Surveillance System"
APP_ENV=development          # development | production
DEBUG=true
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
ALLOWED_HOSTS=["*"]
API_V1_PREFIX=/api/v1

# ── Database (PostgreSQL + TimescaleDB) ──────────────────────────
DATABASE_URL=postgresql+asyncpg://traffic_user:traffic_pass@localhost:5432/traffic_db
DATABASE_URL_SYNC=postgresql://traffic_user:traffic_pass@localhost:5432/traffic_db

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Camera Feed Settings ─────────────────────────────────────────
# Add your camera RTSP URLs as comma-separated values
CAMERA_URLS=rtsp://admin:pass@192.168.1.10:554/stream1,rtsp://admin:pass@192.168.1.11:554/stream1
# For demo / testing without real cameras use 0 for webcam or a video file path
DEMO_MODE=true
DEMO_VIDEO_PATH=./data/demo_traffic.mp4

# ── AI Model Settings ────────────────────────────────────────────
YOLO_MODEL_PATH=./models/yolov8n.pt        # nano=fastest, s/m/l/x=more accurate
YOLO_CONFIDENCE=0.45
YOLO_IOU_THRESHOLD=0.45
ANPR_LANGUAGE=en                           # en for English plates; add 'hi' for Hindi
FRAME_SKIP=2                               # process every Nth frame (reduce CPU load)
MAX_TRACK_AGE=30                           # frames before track is dropped
GPU_ENABLED=false                          # set true if CUDA GPU is available

# ── Speed Estimation ─────────────────────────────────────────────
SPEED_LIMIT_KMH=60
PIXELS_PER_METER=8.5                       # calibrate per camera

# ── Watchlist ────────────────────────────────────────────────────
WATCHLIST_FILE=./data/watchlist.txt        # one plate per line

# ── Notifications — Twilio SMS ───────────────────────────────────
# Get free account at https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1415XXXXXXX
TWILIO_ALERT_NUMBER=+91XXXXXXXXXX          # number to receive alerts

# ── Notifications — SendGrid Email ───────────────────────────────
# Get free API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxx
ALERT_EMAIL_FROM=alerts@yourdomain.com
ALERT_EMAIL_TO=admin@yourdomain.com

# ── Auth ─────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEFAULT_ADMIN_EMAIL=admin@traffic.local
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# ── Video Streaming ──────────────────────────────────────────────
STREAM_FPS=10                              # frames per second to stream to dashboard
JPEG_QUALITY=70                            # 1-100; lower = less bandwidth
